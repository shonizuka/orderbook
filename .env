# ---------------------------------------------------------------------------
# BTC-USD Order Book Aggregator — environment variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in any required values.
# API keys are only needed if you use authenticated exchange endpoints.
# The WebSocket feeds used here (public order book channels) are anonymous.

REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:3000,http://localhost

# Optional: tune queue depth (default 20000)
# DELTA_QUEUE_SIZE=20000
